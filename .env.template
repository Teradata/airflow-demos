# ============================================
# Airbyte ACA System - Environment Template
# ============================================

# -----------------------------
# AWS / Bedrock Configuration
# -----------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# REQUIRED: Bedrock Inference Profile ARN or Model ARN for Chat LLM
# Example:
# BEDROCK_LLM_ARN=arn:aws:bedrock:xx-xx:xxx:application-inference-profile/xxx
BEDROCK_LLM_ARN=
# Optional: Override provider
# BEDROCK_PROVIDER=anthropic
BEDROCK_PROVIDER=

# Embedding model used for RAG
# EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_MODEL_ID=

# -----------------------------
# Airbyte Public API
# -----------------------------
# URL to Airbyte API (public/v1 or v1) — must include the protocol (http/https)
AIRBYTE_API_URL=

# Optional Bearer token for authenticated Airbyte deployments
AIRBYTE_API_TOKEN=

# Your Airbyte workspace ID (UUID)
AIRBYTE_WORKSPACE_ID=


# -----------------------------
# Create / Validate / Sync Controls
# -----------------------------
# true / false — Whether the LLM should also create Airbyte resources
CREATE_IN_AIRBYTE=false

# true / false — Auto-trigger sync after successful connection creation
RUN_SYNC=false
