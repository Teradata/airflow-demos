AIRFLOW_UID=1000
LOAD_EXAMPLES=false
AIRFLOW_PROJ_DIR="./airflow"
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
AIRFLOW__CORE__TEST_CONNECTION=Enabled
# Required in Airflow 3 for internal Execution API token validation between services.
AIRFLOW__API_AUTH__JWT_SECRET=replace-with-long-random-string
# Required in Airflow 3 to sign API/session data consistently across services.
AIRFLOW__API__SECRET_KEY=replace-with-long-random-string
DBT_PROJ_DIR="../dbt_project"
